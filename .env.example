# /try wallet sign-in — HMAC secret for session tokens (set a long random value, e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Local dev only: store /try conversation history on disk instead of GCS
FRANKLIN_STORE_LOCAL=1

# BlockRun gateways the /api/blockrun proxy forwards to. The host is what
# selects the payment chain: blockrun.ai issues a Base (eip155:8453) x402
# requirement, sol.blockrun.ai issues a Solana one. The proxy picks between
# them per request from the x-blockrun-chain header. Both have working
# defaults; override only to point at a staging gateway.
BLOCKRUN_API_BASE=
BLOCKRUN_SOLANA_API_BASE=

# Optional: enables the WalletConnect connector (mobile QR) alongside the
# injected EVM wallet. Without it only browser/in-app wallets can connect.
NEXT_PUBLIC_WALLETCONNECT_ID=

# Upstream for the /api/solana/rpc proxy (balance reads). Defaults to BlockRun's
# own keyless Solana RPC, which is fine for production.
SOLANA_RPC_PROXY_URL=

# Bypasses that proxy entirely and points the browser at an RPC directly. Only
# set this for a provider that serves CORS — BlockRun's does not, which is why
# the proxy exists.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Domain a Sign In With Solana message must be bound to. Pinned rather than read
# off the request Host, so a signature farmed on another origin can't be replayed
# here. Defaults to franklin.run in production, localhost:3000 otherwise — set it
# explicitly for preview/staging deployments.
SIWS_DOMAIN=
